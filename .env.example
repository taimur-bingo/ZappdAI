# Slack app credentials (see manifest.yml / docs/SETUP.md)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# Connection mode: true = Socket Mode (default, needs SLACK_APP_TOKEN),
# false = HTTP mode (needs SLACK_SIGNING_SECRET + a public PORT)
SOCKET_MODE=true
PORT=3000

# Post-sales handoff lead: added FIRST to every new onboarding channel.
# HANDOFF_LEAD_USER_ID wins over HANDOFF_LEAD_EMAIL if both are set.
HANDOFF_LEAD_EMAIL=khantaimur@icloud.com
HANDOFF_LEAD_USER_ID=

# Optional: channel (name or ID) to post a short handoff log line to.
HANDOFF_LOG_CHANNEL=

# New customer channel naming/visibility.
CHANNEL_PREFIX=cust-
CHANNEL_VISIBILITY=private

# Onboarding timeline offsets (business days from kickoff).
SIGNOFF_DAY=7
GOLIVE_DAY=10

# Optional: Asana Personal Access Token. When set, every intake submission
# also duplicates the "Zappd Onboarding — TEMPLATE" project for the new
# restaurant and adds a card to the "Zappd — Onboarding Pipeline" board.
# Left unset, the app runs exactly as before (Slack-only), no error.
# Generate one at Asana → your profile photo → My Settings → Apps →
# Manage Developer Apps → Personal Access Tokens. This is a real secret —
# put the value only in your local .env (already gitignored), never here.
ASANA_ACCESS_TOKEN=

# Daily onboarding-status digest (needs ASANA_ACCESS_TOKEN above too — no
# Asana token, no data to post). Set STANDUP_CHANNEL to empty to disable.
STANDUP_CHANNEL="#onboarding-standup"
STANDUP_HOUR=9
STANDUP_MINUTE=0
